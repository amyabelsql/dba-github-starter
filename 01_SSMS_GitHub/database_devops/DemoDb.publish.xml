<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <TargetDatabaseName>DemoDb</TargetDatabaseName>
    <DeployScriptFileName>DemoDb.sql</DeployScriptFileName>

    <!-- Generate the script and look at it. Do not let a tool change prod unattended. -->
    <BlockOnPossibleDataLoss>True</BlockOnPossibleDataLoss>
    <DropObjectsNotInSource>False</DropObjectsNotInSource>
    <BackupDatabaseBeforeChanges>False</BackupDatabaseBeforeChanges>
    <ScriptDatabaseOptions>False</ScriptDatabaseOptions>
    <VerifyDeployment>True</VerifyDeployment>
  </PropertyGroup>
</Project>
